# このファイルをコピーして .env を作成してください。
#   cp .env.example .env
#
# すべて空のままでもアプリは起動します（該当機能が無効になるだけです）。
# DB 接続情報は compose.yaml の environment: で注入されるため、ここには不要です。

# --- Google 認証 ---------------------------------------------------------
# 両方が設定されているときだけ Google ログインが有効になります。
# (config/initializers/devise.rb)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- メール送信 (開発環境) -----------------------------------------------
# SMTP_ADDRESS が空のあいだは delivery_method = :test となり、
# メールは実際には送信されません。パスワード再設定などを実際に試したい場合のみ設定します。
# (config/environments/development.rb)
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=

# devise が送信するメールの From アドレス
# (config/initializers/devise.rb)
MAILER_SENDER=

# --- アプリのホスト ------------------------------------------------------
# メール本文中の URL 生成に使われます。
DEV_HOST=localhost
DEV_PORT=3000
