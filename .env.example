# このファイルをコピーして .env を作成してください。
#   cp .env.example .env
#
# すべて空のままでもアプリは起動します（該当機能が無効になるだけです）。
# DB 接続情報は compose.yaml の environment: で注入されるため、ここには不要です。

# --- Google 認証 ---------------------------------------------------------
# 両方が設定されているときだけ Google ログインが有効になります。
# (config/initializers/devise.rb)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- メール送信 (開発環境) -----------------------------------------------
# SMTP_ADDRESS が空のあいだは delivery_method = :test となり、
# メールは実際には送信されません。パスワード再設定などを実際に試したい場合のみ設定します。
# (config/environments/development.rb)
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=

# devise が送信するメールの From アドレス
# (config/initializers/devise.rb)
MAILER_SENDER=

# --- アプリのホスト ------------------------------------------------------
# メール本文中の URL 生成に使われます。
DEV_HOST=localhost
DEV_PORT=3000

# --- AI による仕訳提案 (任意) ---------------------------------------------
# OLLAMA_URL を設定したときだけ、仕訳入力画面に「AI提案」ボタンが出ます。
# 未設定ならアプリは従来どおり動作し、AI 機能は一切現れません。
#
# 接続先は同じマシン・LAN 内の別マシン・リモートのサーバのいずれでも構いません。
#   同じマシン (Docker Desktop): http://host.docker.internal:11434
#   リモート                  : https://ollama.example.com
#
# 帳簿データ (摘要・勘定科目・過去の仕訳) がこの宛先に送信されます。
# 自分で管理していない Ollama を指定しないでください。
OLLAMA_URL=
# 認証が必要な場合のみ設定 (Authorization: Bearer で送信)
OLLAMA_API_KEY=
# 使用するモデル (未設定なら qwen3.8:27b-q4_K_M)
OLLAMA_MODEL=
# 応答待ちの上限秒数 (未設定なら 60)
OLLAMA_TIMEOUT=
