name: Gemini PR Review

# **このワークフローは停止中です。**
# ファイル名を gemini-review.yml.disabled にしてあります。GitHub Actions が
# 読むのは .github/workflows 配下の .yml / .yaml だけなので、この拡張子のままでは
# 自動起動も手動実行もされません。
#
# 止めている理由: Gemini API の無料枠は 1 日あたりのリクエスト数が少なく
# (2026-09 時点で gemini-3.5-flash は 20 リクエスト/日)、1 レビューは指摘 1 件ごとに
# モデルとの往復が発生するため 10 リクエスト前後を消費する。PR 2 本で枠を使い切り、
# 概要の生成 (gemini-summary.yml) まで巻き添えで失敗していた。
#
# 再開するには拡張子を .yml に戻す。中身は停止前のままなので、戻せば
# PR の opened / reopened / ready_for_review で自動起動し、
# Actions タブから PR 番号を指定した手動実行もできる。
on:
  pull_request:
    types: [ opened, reopened, ready_for_review ]
  workflow_dispatch:
    inputs:
      pr_number:
        description: 'レビュー対象の PR 番号'
        required: true
        type: string

concurrency:
  group: 'gemini-review-${{ github.event.pull_request.number || inputs.pr_number }}'
  cancel-in-progress: true

jobs:
  review:
    # ドラフト PR はレビューしない(作業途中への指摘と無料枠の消費を避ける)
    if: ${{ github.event_name == 'workflow_dispatch' || github.event.pull_request.draft == false }}
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read
      pull-requests: write
      issues: write
      id-token: write

    steps:
      - name: Checkout repository
        uses: actions/checkout@v6
        with:
          persist-credentials: false

      - name: レビュー観点を読み込む
        # .gemini/styleguide.md をそのまま ADDITIONAL_CONTEXT として渡す。
        # code-review 拡張は core ツール(ファイル読み取り)を無効にして動くため、
        # ファイルを読ませるのではなくワークフロー側で内容を注入する。
        run: |
          {
            echo 'ADDITIONAL_CONTEXT<<GEMINI_STYLEGUIDE_EOF'
            cat .gemini/styleguide.md
            echo 'GEMINI_STYLEGUIDE_EOF'
          } >> "$GITHUB_ENV"

      - name: Gemini によるレビュー
        id: gemini
        # ここでは失敗させず、次のステップで失敗理由を判定して出し分ける
        continue-on-error: true
        uses: google-github-actions/run-gemini-cli@v0
        env:
          GEMINI_CLI_TRUST_WORKSPACE: 'true'
          GITHUB_TOKEN: '${{ secrets.GITHUB_TOKEN }}'
          GEMINI_API_KEY: '${{ secrets.GEMINI_API_KEY }}'
          REPOSITORY: '${{ github.repository }}'
          PULL_REQUEST_NUMBER: '${{ github.event.pull_request.number || inputs.pr_number }}'
        with:
          gemini_api_key: '${{ secrets.GEMINI_API_KEY }}'
          # モデルは Gemini CLI のルーティングに任せる(Flash 系が選ばれる)。
          # 固定したい場合のみ gemini_model を指定する。
          github_pr_number: '${{ github.event.pull_request.number || inputs.pr_number }}'
          workflow_name: 'gemini-review'
          settings: |-
            {
              "model": {
                "maxSessionTurns": 25
              },
              "mcpServers": {
                "github": {
                  "command": "docker",
                  "args": [
                    "run", "-i", "--rm",
                    "-e", "GITHUB_PERSONAL_ACCESS_TOKEN",
                    "ghcr.io/github/github-mcp-server:v0.27.0"
                  ],
                  "includeTools": [
                    "add_comment_to_pending_review",
                    "pull_request_read",
                    "pull_request_review_write"
                  ],
                  "env": {
                    "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
                  }
                }
              },
              "tools": {
                "core": [
                  "mcp_github_*",
                  "activate_skill"
                ]
              }
            }
          extensions: |
            [
              "https://github.com/gemini-cli-extensions/code-review"
            ]
          # PR の URL を引数で直接渡す(拡張が公式にサポートする形式)。
          # シェルツールは許可していないため、モデルが環境変数を自力で
          # 読みに行かずに済むようにしておく。
          prompt: '/pr-code-review https://github.com/${{ github.repository }}/pull/${{ github.event.pull_request.number || inputs.pr_number }}'


      - name: レビュー結果の判定
        if: always()
        env:
          OUTCOME: '${{ steps.gemini.outcome }}'
          GEMINI_ERROR: '${{ steps.gemini.outputs.error }}'
          GH_TOKEN: '${{ secrets.GITHUB_TOKEN }}'
          PR_NUMBER: '${{ github.event.pull_request.number || inputs.pr_number }}'
          RUN_URL: '${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}'
        run: |
          set -uo pipefail

          # クォータ超過の通知コメントを識別するためのマーカー。
          # 同じ PR で何度もスキップしたときにコメントを増やさず、既存を更新する。
          MARKER='<!-- gemini-review-quota -->'

          # マーカー付きの既存コメント ID を返す(無ければ空)
          find_quota_comment() {
            gh api "repos/${GITHUB_REPOSITORY}/issues/${PR_NUMBER}/comments?per_page=100" \
              --jq "[.[] | select(.body | startswith(\"${MARKER}\"))] | last | .id // empty" 2>/dev/null
          }

          upsert_quota_comment() {
            local id
            id="$(find_quota_comment)"
            if [ -n "${id}" ]; then
              gh api --method PATCH "repos/${GITHUB_REPOSITORY}/issues/comments/${id}" \
                -F "body=@${1}" --silent
            else
              gh api --method POST "repos/${GITHUB_REPOSITORY}/issues/${PR_NUMBER}/comments" \
                -F "body=@${1}" --silent
            fi
          }

          # レビューが通ったら、過去のスキップ通知は誤解のもとなので消す
          delete_quota_comment() {
            local id
            id="$(find_quota_comment)"
            if [ -n "${id}" ]; then
              gh api --method DELETE "repos/${GITHUB_REPOSITORY}/issues/comments/${id}" --silent
            fi
          }

          if [ "${OUTCOME}" = "success" ]; then
            echo "レビューを投稿しました。" >> "${GITHUB_STEP_SUMMARY}"
            delete_quota_comment
            exit 0
          fi

          # 429 / クォータ超過は「使い切った」だけなので PR を落とさない。
          # ただしチェックが緑のままだとレビュー済みと誤解されるため、PR にも通知する。
          if printf '%s' "${GEMINI_ERROR}" | grep -qiE '429|quota|RESOURCE_EXHAUSTED|exhausted'; then
            echo "::warning title=Gemini のクォータ超過::Gemini API の 1 日あたりのリクエスト上限を使い切ったため、レビューをスキップしました。コードの問題ではありません。"
            {
              echo "## Gemini レビューをスキップしました"
              echo
              echo "**理由: Gemini API のクォータ超過 (429)**"
              echo
              echo "1 日あたりのリクエスト上限を使い切っています。翌日のリセット後に再実行するか、"
              echo "Actions タブから workflow_dispatch で PR 番号を指定して実行してください。"
              echo
              echo "コードに問題があるわけではありません。"
              echo
              echo '<details><summary>API からのエラー</summary>'
              echo
              echo '```'
              printf '%s\n' "${GEMINI_ERROR}"
              echo '```'
              echo
              echo '</details>'
            } >> "${GITHUB_STEP_SUMMARY}"

            BODY_FILE="$(mktemp)"
            {
              printf '%s\n' "${MARKER}"
              echo "## ⏳ Gemini レビューをスキップしました"
              echo
              echo "**この PR はまだレビューされていません。** コードの問題ではありません。"
              echo
              echo "Gemini API の 1 日あたりのリクエスト上限(無料枠は 20 リクエスト/日)を使い切ったため、"
              echo "レビューを生成できませんでした。チェックは緑のままですが、指摘が無かったわけではありません。"
              echo
              echo "### 再実行する方法"
              echo
              echo "無料枠のリセットは太平洋時間の午前 0 時(日本時間の 16:00〜17:00 頃)です。それ以降に:"
              echo
              echo "- Actions タブ > Gemini PR Review > Run workflow で PR 番号 \`${PR_NUMBER}\` を指定して実行"
              echo "- または、この PR を Close -> Reopen"
              echo
              echo "---"
              echo
              echo "[実行ログ](${RUN_URL}) · $(date -u '+%Y-%m-%d %H:%M UTC')"
            } > "${BODY_FILE}"
            upsert_quota_comment "${BODY_FILE}"

            exit 0
          fi

          echo "::error title=Gemini レビューの失敗::クォータ超過以外の理由でレビューに失敗しました。ログを確認してください。"
          {
            echo "## Gemini レビューが失敗しました"
            echo
            echo "クォータ超過 (429) ではない失敗です。設定または API の問題の可能性があります。"
            echo
            echo '```'
            printf '%s\n' "${GEMINI_ERROR}"
            echo '```'
          } >> "${GITHUB_STEP_SUMMARY}"
          exit 1
