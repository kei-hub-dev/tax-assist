<% content_for :title, "残高設定" %>

<div class="page-center">
  <div class="auth wide">
    <h1 class="page-title">残高設定</h1>
    <p class="text-center mb-16">選択中の会計年度:<%= @period.accounting_year %> (繰越:<%= @prev_year %>)</p>

    <%= render "shared/error_messages", object: @opening_balance %>

    <%= form_with url: opening_balances_path, method: :patch, local: true,
                  html: { id: "opening-balances-form",
                          data: { controller: "opening-balance-totals",
                                  action: "input->opening-balance-totals#recalculate" } } do %>
      <table class="table mb-12">
        <thead>
          <tr>
            <th>科目</th>
            <th class="text-right">借方残高</th>
            <th class="text-right">貸方残高</th>
          </tr>
        </thead>
        <tbody>
          <% @accounts.each do |account| %>
            <% bal = @balances[account.id] %>
            <tr>
              <td><%= account.name %></td>
              <td class="text-right">
                <%= number_field_tag "opening_balances[#{account.id}][debit_amount]", bal&.debit_amount || 0,
                      min: 0, step: 1, data: { opening_balance_totals_target: "debit" } %>
              </td>
              <td class="text-right">
                <%= number_field_tag "opening_balances[#{account.id}][credit_amount]", bal&.credit_amount || 0,
                      min: 0, step: 1, data: { opening_balance_totals_target: "credit" } %>
              </td>
            </tr>
          <% end %>

          <% if @accounts.empty? %>
            <tr>
              <td colspan="3" class="text-center text-muted">まず勘定科目を作成してください</td>
            </tr>
          <% end %>

          <tr id="sum-row" class="sum-row" data-opening-balance-totals-target="sumRow">
            <td>合計</td>
            <td id="total-debit"  class="text-right" data-opening-balance-totals-target="totalDebit"><%= amt(@total_debit)  %></td>
            <td id="total-credit" class="text-right" data-opening-balance-totals-target="totalCredit"><%= amt(@total_credit) %></td>
          </tr>
          <tr>
            <td colspan="3" id="sum-note" class="text-center text-danger hidden" aria-live="polite"
                data-opening-balance-totals-target="note">
              借方と貸方の合計が一致していません
            </td>
          </tr>
        </tbody>
      </table>

      <div class="actions vstack">
        <%= link_to "戻る", accounting_menu_path, class: "btn btn-outline btn-sm btn-block" %>
        <%= submit_tag "保存", id: "ob-submit", class: "btn btn-sm btn-block", disabled: @accounts.empty? %>
      </div>
    <% end %>
  </div>
</div>
