<%= render "shared/error_messages", object: @account %>

<%= form_with model: @account, local: true,
              html: { class: "form",
                      data: { controller: "account-sub-category",
                              account_sub_category_options_value: I18n.t("accounts.sub_categories").to_json,
                              account_sub_category_selected_value: @account.sub_category.to_s } } do |f| %>
  <div class="field">
    <%= f.label :category, "区分" %>
    <% categories = [["資産","asset"],["負債","liability"],["純資産","equity"],["収益","revenue"],["費用","expense"]] %>
    <%= f.select :category,
          options_for_select(categories, @account.category),
          { include_blank: "選択してください" },
          id: "account_category",
          data: { account_sub_category_target: "category",
                  action: "account-sub-category#categoryChanged" } %>
  </div>

  <div class="field" data-account-sub-category-target="subCategoryField">
    <%= f.label :sub_category, "サブ区分" %>
    <%= f.select :sub_category, [], { include_blank: "指定なし" },
          id: "account_sub_category",
          data: { account_sub_category_target: "subCategory" } %>
  </div>

  <div class="field">
    <%= f.label :name, "科目名" %>
    <%= f.text_field :name %>
  </div>

  <div class="actions vstack">
    <%= f.submit "保存", class: "btn btn-sm btn-block" %>
    <%= link_to "戻る", accounts_path, class: "btn btn-outline btn-sm btn-block" %>
  </div>
<% end %>
