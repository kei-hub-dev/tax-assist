<% account_options = current_user.accounts.order(:category, :name) %>

<div class="table-wrap mt-12" data-controller="journal-entry-lines">
  <table class="table">
    <thead>
      <tr>
        <th>勘定科目</th>
        <th>貸借</th>
        <th class="text-right">金額</th>
        <th>メモ</th>
        <th class="col-100"></th>
      </tr>
    </thead>
    <tbody id="lines" data-journal-entry-lines-target="rows">
      <%= f.fields_for :journal_entry_lines do |lf| %>
        <tr class="line">
          <%= lf.hidden_field :id %>
          <%= lf.hidden_field :_destroy, value: 0 %>
          <td><%= lf.collection_select :account_id, account_options, :id, :name, include_blank: "選択" %></td>
          <td><%= lf.select :dc, [["借方","debit"],["貸方","credit"]], include_blank: "選択" %></td>
          <td class="text-right"><%= lf.number_field :amount, min: 0, step: 1 %></td>
          <td><%= lf.text_field :memo, list: "journal-entry-memo-list" %></td>
          <td>
            <button type="button" class="btn btn-outline btn-sm"
                    data-action="journal-entry-lines#remove">
              行削除
            </button>
          </td>
        </tr>
        <tr class="line-errors">
          <td colspan="5">
            <%= render "shared/error_messages", object: lf.object %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="actions mt-8">
    <button type="button" class="btn btn-sm"
            data-action="journal-entry-lines#add">行を追加</button>
  </div>

  <%# 行追加時に複製されるひな形。child_index の NEW_RECORD を一意な値へ置換する %>
  <template data-journal-entry-lines-target="template">
    <%= f.fields_for :journal_entry_lines, JournalEntryLine.new, child_index: "NEW_RECORD" do |lf| %>
      <tr class="line">
        <%= lf.hidden_field :id %>
        <%= lf.hidden_field :_destroy, value: 0 %>
        <td><%= lf.collection_select :account_id, account_options, :id, :name, include_blank: "選択" %></td>
        <td><%= lf.select :dc, [["借方","debit"],["貸方","credit"]], include_blank: "選択" %></td>
        <td class="text-right"><%= lf.number_field :amount, min: 0, step: 1, value: 0 %></td>
        <td><%= lf.text_field :memo, list: "journal-entry-memo-list" %></td>
        <td>
          <button type="button" class="btn btn-outline btn-sm"
                  data-action="journal-entry-lines#remove">
            行削除
          </button>
        </td>
      </tr>
      <tr class="line-errors">
        <td colspan="5">
          <%= render "shared/error_messages", object: lf.object %>
        </td>
      </tr>
    <% end %>
  </template>
</div>
